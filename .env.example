# ==========================================================
# AUTO-GARAGE Infrastructure Docker Environment Variables Example
# Copy this file to .env before starting infrastructure containers:
#   cp .env.example .env
# ==========================================================

# Database Infrastructure Configuration (SQL Server Docker Container)
SQLSERVER_DB=GarageManagementSystem
SQLSERVER_USER=sa
SQLSERVER_PASSWORD=YourPassword123
SQLSERVER_PORT=1433

# ==========================================================
# Local Backend Configuration (for reference when running outside Docker via mvn spring-boot:run)
# ==========================================================
# SERVER_PORT=8080
# SPRING_DATASOURCE_URL=jdbc:sqlserver://localhost:1433;databaseName=GarageManagementSystem;encrypt=true;trustServerCertificate=true;
# SPRING_DATASOURCE_USERNAME=sa
# SPRING_DATASOURCE_PASSWORD=YourPassword123
# JWT_SECRET= YOUR_JWT_SECRET
# JWT_EXPIRATION= YOUR_JWT_EXPIRATION
# CORS_ALLOWED_ORIGIN_PATTERNS=*

# ==========================================================
# Local Frontend Configuration (for reference when running outside Docker via npm run dev)
# ==========================================================
# VITE_API_BASE_URL=http://localhost:8080/api
# VITE_WS_BASE_URL=http://localhost:8080/ws



# SePay: backend reads root .env automatically; use unquoted values. Never commit the real key.
SEPAY_ENABLED=false
SEPAY_ENVIRONMENT=test
SEPAY_WEBHOOK_KEY=
SEPAY_BANK_CODE=
SEPAY_BANK_NAME=
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=
GARAGE_SUPPORT_ENABLED=false
# Support chat / Gemini. Use KEY=value without quotes or export.
GARAGE_SUPPORT_GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=

# Verified garage coordinates only: branchId:latitude:longitude;branchId:latitude:longitude
# Leave empty while branch addresses are demo data.
GARAGE_SUPPORT_BRANCH_COORDINATES=
