# ==========================================================
# AUTO-GARAGE Docker Environment Variables Example
# Copy this file to .env before starting containers:
#   cp .env.example .env
# ==========================================================

# Database Configuration (SQL Server)
SQLSERVER_DB=GarageManagementSystem
SQLSERVER_USER=sa
SQLSERVER_PASSWORD=YourPassword123
SQLSERVER_PORT=1433

# Backend Configuration (Spring Boot)
BACKEND_PORT=8080
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION=86400000
# CORS Origin patterns (supports '*' for development or comma-separated patterns like 'http://localhost:*,http://192.168.*:*')
CORS_ALLOWED_ORIGIN_PATTERNS=*

# Frontend Configuration (React / Vite)
FRONTEND_PORT=3001
# Note: In browser runtime, API and WS base URLs automatically resolve to current hostname (LAN IP or localhost).
# To override with a dedicated custom hostname, uncomment and configure below:
# VITE_API_BASE_URL=http://localhost:8080/api
# VITE_WS_BASE_URL=http://localhost:8080/ws
VITE_API_BASE_URL=http://localhost:8080/api
VITE_WS_BASE_URL=http://localhost:8080/ws

