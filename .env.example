# ==========================================================
# AUTO-GARAGE Infrastructure Docker Environment Variables Example
# Copy this file to .env before starting infrastructure containers:
#   cp .env.example .env
# ==========================================================

# Database Infrastructure Configuration (SQL Server Docker Container)
SQLSERVER_DB=GarageManagementSystem
SQLSERVER_USER=sa
SQLSERVER_PASSWORD=YourPassword123
SQLSERVER_PORT=1433

# ==========================================================
# Local Backend Configuration (for reference when running outside Docker via mvn spring-boot:run)
# ==========================================================
# SERVER_PORT=8080
# SPRING_DATASOURCE_URL=jdbc:sqlserver://localhost:1433;databaseName=GarageManagementSystem;encrypt=true;trustServerCertificate=true;
# SPRING_DATASOURCE_USERNAME=sa
# SPRING_DATASOURCE_PASSWORD=YourPassword123
# JWT_SECRET= YOUR_JWT_SECRET
# JWT_EXPIRATION= YOUR_JWT_EXPIRATION
# CORS_ALLOWED_ORIGIN_PATTERNS=*

# ==========================================================
# Local Frontend Configuration (for reference when running outside Docker via npm run dev)
# ==========================================================
# VITE_API_BASE_URL=http://localhost:8080/api
# VITE_WS_BASE_URL=http://localhost:8080/ws


